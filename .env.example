# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Public HTTPS URL the bot's webhook will be registered at, e.g. https://your-domain.com
TELEGRAM_WEBHOOK_BASE_URL=https://your-domain.com
# Shared secret checked against the X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=change-me

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Database - existing Postgres on the NAS (not the local docker-compose db)
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>

# App
LOG_LEVEL=INFO
